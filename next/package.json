{
  "name": "cinemavault-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CinemaVault Next — parallel TypeScript rewrite. The root-level app is untouched until cutover.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "check:bundle": "node scripts/check-bundle.mjs dist",
    "check:headers": "node scripts/sync-security-headers.mjs --check",
    "gate:data": "node scripts/data-gate.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "e2e": "node tests/e2e/offline.e2e.mjs",
    "perf": "node tests/e2e/perf.e2e.mjs",
    "a11y": "node tests/e2e/a11y.e2e.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  }
}
